        if (w.minimized || w.hidden || !root.onActivity(w)) state.push("HIDDEN");
        if (w.skipTaskbar) state.push("SKIP_TASKBAR");
        if (w.fullScreen) state.push("FULLSCREEN");
        if (mode & 1) state.push("MAXIMIZED_VERT");
        if (mode & 2) state.push("MAXIMIZED_HORZ");
        if (w.onAllDesktops) state.push("STICKY");
        if (w.keepAbove) state.push("ABOVE");
        if (w.demandsAttention) state.push("DEMANDS_ATTENTION");
