    function flush() {
        root.ensureTop();
        const json = JSON.stringify(root.collect());
        if (json === root.lastJson) return; // nothing changed: nothing sent
        root.lastJson = json;
        bridge.arguments = [json];
        bridge.call();
    }

    // coalesces the bursts (a window being dragged fires on every step) into one send per 40 ms
    // Window signals are connected from here, and a connection outlives this script when it is unloaded
    // (Capri restarted: the script is loaded again), calling what is gone. So it says nothing and does
    // nothing once the timer is gone, and everything connected is taken back when the script ends.
    function schedule() {
        if (!flushTimer) return;
        if (!flushTimer.running) flushTimer.start();
    }

    function watch(w) {
        if (!w) return;
        const key = String(w.internalId);
        if (root.watched[key]) return;
        root.watched[key] = true;
        const signals = [
            "frameGeometryChanged", "minimizedChanged", "desktopsChanged", "activitiesChanged",
            "fullScreenChanged", "maximizedChanged", "captionChanged", "skipTaskbarChanged",
            "hiddenChanged", "stackingOrderChanged", "activeChanged", "outputChanged",
        ];
        for (let i = 0; i < signals.length; i++) {
            try {
                const signal = w[signals[i]];
                signal.connect(root.poke);
                root.hooked.push(signal);
            } catch (e) {
                // this KWin has no such signal: the poll below still catches the change
            }
        }
    }

    function forget(w) {
        if (!w) return;
        const key = String(w.internalId);
        delete root.watched[key];
        delete root.ids[key];
    }

    // the receiver's reply: who it is, so its own overlay is left out of the list
    function onReply(returned) {
        root.failing = false;
        try {
            root.applySelf(JSON.parse(returned[0]));
        } catch (e) {
            // an empty or foreign reply: keep what we know
        }
    }

    function applySelf(next) {
        if (!next || typeof next !== "object") return;
        const changed = next.selfPid !== root.cfg.selfPid || next.selfTitle !== root.cfg.selfTitle;
        root.cfg = next;
        if (changed) root.lastJson = ""; // send again, now without the overlay
    }

    function onFailed() {
        // the receiver is gone (Capri closed): sent again when it is back
        root.lastJson = "";
        if (!root.failing) console.warn("capri-windows: no receiver on org.capri.WindowBridge");
        root.failing = true;
    }

    DBusCall {
        id: bridge
        service: "org.capri.WindowBridge"
        path: "/org/capri/WindowBridge"
        dbusInterface: "org.capri.WindowBridge"
        method: "Update"
        onFinished: (returned) => root.onReply(returned)
        onFailed: root.onFailed()
    }

    DBusCall {
        id: cursorCall
        service: "org.capri.WindowBridge"
        path: "/org/capri/WindowBridge"
        dbusInterface: "org.capri.WindowBridge"
        method: "Cursor"
        onFailed: root.onFailed()
    }

    DBusCall {
        id: commandCall
        service: "org.capri.WindowBridge"
        path: "/org/capri/WindowBridge"
        dbusInterface: "org.capri.WindowBridge"
        method: "Command"
        onFailed: root.onFailed()
    }

    DBusCall {
        id: pollCall
        service: "org.capri.WindowBridge"
        path: "/org/capri/WindowBridge"
        dbusInterface: "org.capri.WindowBridge"
        method: "Poll"
        onFinished: (returned) => root.runCommands(returned[0])
    }

    ShortcutHandler {
        name: "Capri: stow her or bring her back"
        text: "Capri: stow her or bring her back"
        sequence: "Ctrl+Alt+C"
        onActivated: root.command("toggle")
    }

    Timer {
        id: giveBackTimer
        interval: 250
        repeat: false
        onTriggered: root.giveBackIfStill()
    }

    Timer {
        id: flushTimer
        interval: 40
        repeat: false
        onTriggered: root.flush()
    }

    // The safety net for what has no signal (the workspace in view, the order of the stack,
    // outputs), and the way back after the receiver was away.
    Timer {
        interval: 500
        repeat: true
        running: true
        onTriggered: root.flush()
    }

    // The receiver's commands (the keyboard for her chat, closing an app): often enough that typing
    // to her works as soon as the chat opens.
    Timer {
        interval: 150
        repeat: true
        running: true
        onTriggered: {
            pollCall.call();
            root.checkSelf();
        }
    }

    // 30 times a second at most, and only while the pointer moves
    Timer {
        interval: 33
        repeat: true
        running: true
        onTriggered: root.sendCursor()
    }

    Connections {
        target: Workspace

        function onWindowAdded(window) {
            root.watch(window);
            root.schedule();
        }

        function onWindowRemoved(window) {
            root.forget(window);
            root.schedule();
        }

        function onWindowActivated(window) {
            root.windowActivated(window);
        }

        function onScreensChanged() {
            root.schedule();
        }

        function onDesktopsChanged() {
            root.schedule();
        }

        function onCurrentActivityChanged(id) {
            root.schedule();
        }
    }

    Component.onDestruction: {
        for (let i = 0; i < root.hooked.length; i++) {
            try {
                root.hooked[i].disconnect(root.poke);
            } catch (e) {
                // the window is gone, or the signal: nothing left to take back
            }
        }
        root.hooked = [];
    }

    Component.onCompleted: {
        const order = Workspace.stackingOrder;
        for (let i = 0; i < order.length; i++) root.watch(order[i]);
        root.flush();
    }
}
