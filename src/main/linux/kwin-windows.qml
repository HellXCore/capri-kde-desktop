        if (w.dock) return ["DOCK"];
        if (w.onScreenDisplay || w.notification || w.criticalNotification) return ["NOTIFICATION"];
        if (w.tooltip) return ["TOOLTIP"];
        if (w.dndIcon) return ["DND"];
        if (w.comboBox) return ["COMBO"];
        if (w.dropdownMenu) return ["DROPDOWN_MENU"];
        if (w.popupMenu || w.appletPopup || w.popupWindow) return ["POPUP_MENU"];
        if (w.menu) return ["MENU"];
        if (w.splash) return ["SPLASH"];
        if (w.toolbar) return ["TOOLBAR"];
