        if (answer.self) root.applySelf(answer.self);
        if (answer.next > 0) root.pollEvery(answer.next);
        const queued = answer.commands || [];
        for (let i = 0; i < queued.length; i++) {
            if (queued[i].op === "close") root.closeWindows(queued[i].pids);
            else if (queued[i].op === "focus") root.setFocus(Boolean(queued[i].on));
        }
    }

    // the pace of the poll, as the receiver says it (never faster than 100 ms or slower than 1 s)
    function pollEvery(ms) {
        const v = Math.max(100, Math.min(1000, Math.round(ms)));
        if (pollTimer.interval !== v) pollTimer.interval = v;
    }

    // like the close button: the app can still ask to save
    function closeWindows(pids) {
        if (!pids || pids.length === 0) return;
        const order = Workspace.stackingOrder;
        for (let i = 0; i < order.length; i++) {
            const w = order[i];
            if (!w || w.deleted || !w.closeable || root.isSelf(w)) continue;
            if (!(w.normalWindow || w.dialog)) continue;
            if (pids.indexOf(w.pid) < 0) continue;
            root.trace("close " + root.traceName(w));
            try {
                w.closeWindow();
            } catch (e) {
                console.warn("capri-windows: could not close a window:", e);
            }
        }
    }

    // ---------- when to send ----------

    // The net under the signals (the workspace in view, the order of the stack, the screens have none
    // of their own). Looking at everything (collect + JSON) twice a second, in KWin's own thread, is a
    // lot for "nothing changed": a short key of what the signals cannot say goes first, and the full
    // look only follows when it changed, or every fourth beat (2 s) whatever it says.
    function fingerprint() {
        const order = Workspace.stackingOrder;
        let k = "";
        for (let i = 0; i < order.length; i++) {
            const w = order[i];
            if (!w || w.deleted) continue;
            k += String(w.internalId) + (w.minimized ? "m" : "") + (w.hidden ? "h" : "") + ",";
        }
        const a = Workspace.activeWindow;
        k += "|" + (a ? String(a.internalId) : "");
        k += "|" + (Workspace.currentDesktop ? Workspace.currentDesktop.x11DesktopNumber : "");
        const screens = Workspace.screens;
        for (let i = 0; i < screens.length; i++) {
            const g = screens[i].geometry;
            k += "|" + Math.round(g.x) + "," + Math.round(g.y) + "," + Math.round(g.width) + "," + Math.round(g.height);
        }
        return k;
    }

    function safetyNet() {
        if (root.movingWin) return;
        // reconciliation every 30 s: signals + the fingerprint cover everything else
        root.netTick = (root.netTick + 1) % 60;
        const key = root.fingerprint();
        if (!root.dirty && root.netTick !== 0 && key === root.netKey) return;
        root.netKey = key;
        root.flush();
    }

    function flush() {
        // while a window is dragged only Move talks (id,x,y,w,h); moveFinished sends the full one
        if (root.movingWin) return;
        root.dirty = false;
        root.ensureTop();
        const json = JSON.stringify(root.collect());
        if (json === root.lastJson) return; // nothing changed: nothing sent
        root.lastJson = json;
        bridge.arguments = [json];
        bridge.call();
    }

    // coalesces the bursts (a window being dragged fires on every step) into one send per 40 ms
    // Window signals are connected from here, and a connection outlives this script when it is unloaded
    // (Capri restarted: the script is loaded again), calling what is gone. So it says nothing and does
    // nothing once the timer is gone, and everything connected is taken back when the script ends.
    function schedule() {
        if (!flushTimer) return;
        root.dirty = true; // every caller of schedule wants a re-collect
        if (!flushTimer.running) flushTimer.start();
    }

    function watch(w) {
        if (!w) return;
        const key = String(w.internalId);
        if (root.watched[key]) return;
        root.watched[key] = true;
        root.hookMove(w);
        root.hookCaption(w);
        root.hookMinimize(w);
        const signals = [
            "frameGeometryChanged", "minimizedChanged", "desktopsChanged", "activitiesChanged",
            "fullScreenChanged", "maximizedChanged", "skipTaskbarChanged",
            "hiddenChanged", "stackingOrderChanged", "activeChanged", "outputChanged",
        ];
        for (let i = 0; i < signals.length; i++) {
            try {
                const signal = w[signals[i]];
                signal.connect(root.poke);
                root.hooked.push({ w: w, s: signal, f: root.poke });
            } catch (e) {
                // this KWin has no such signal: the poll below still catches the change
            }
        }
    }

    function forget(w) {
        if (!w) return;
        const key = String(w.internalId);
        delete root.watched[key];
        delete root.ids[key];
        delete root.tuned[key];
        if (root.movingWin === w) {
            root.movingWin = null;
            root.moveGeo = null;
        }
        // drop this window's hooks now, not only at script end (long sessions no longer accumulate them)
        root.hooked = root.hooked.filter((h) => {
            if (h.w !== w) return true;
            try { h.s.disconnect(h.f); } catch (e) { /* gone already */ }
            return false;
        });
    }

    // ---------- the light channel: a window being dragged or resized ----------
    // Only "id,x,y,w,h" goes out (KWin's logical pixels), at most about every 8 ms, instead of the
    // whole desktop as JSON behind the 40 ms flush. Without these signals in this KWin nothing is
    // connected, movingWin stays null and the full Update does all of it, as before.

    function hookMove(w) {
        const pairs = [
            ["interactiveMoveResizeStarted", () => root.moveStarted(w)],
            ["interactiveMoveResizeStepped", (geo) => root.moveStepped(w, geo)],
            ["interactiveMoveResizeFinished", () => root.moveFinished(w)],
        ];
        for (let i = 0; i < pairs.length; i++) {
            try {
                const signal = w[pairs[i][0]];
                signal.connect(pairs[i][1]);
                root.hooked.push({ w: w, s: signal, f: pairs[i][1] });
            } catch (e) {
                // no such signal here
            }
        }
    }

    // A caption changes as often as a terminal prints or a browser loads a tab, and all of it used to
    // wake the full collect. The payload only has a title in two places: the AIs the window in front
    // is (its caption), and telling the overlay from the other windows (her title). So only those.
    function hookCaption(w) {
        try {
            const signal = w.captionChanged;
            const f = () => {
                if (w === Workspace.activeWindow || !root.selfWin || root.isSelf(w)) root.poke();
            };
            signal.connect(f);
            root.hooked.push({ w: w, s: signal, f: f });
        } catch (e) {
            // no such signal here: the 500 ms net below catches the change
        }
    }

    function moveStarted(w) {
        if (root.isSelf(w)) return;
        root.movingWin = w;
    }

    // the first step goes out at once; the ones within the next 8 ms are merged (the latest wins)
    function moveStepped(w, geo) {
        if (root.isSelf(w)) return;
        root.movingWin = w;
        root.moveGeo = geo;
        moveIdleTimer.restart();
        if (!moveTimer.running) {
            root.flushMove();
            moveTimer.start();
        }
    }

    function flushMove() {
        const w = root.movingWin;
        const g = root.moveGeo;
        if (!w || w.deleted || !g) return;
        root.moveGeo = null;
        moveCall.arguments = [root.idOf(w) + "," + Math.round(g.x) + "," + Math.round(g.y) + ","
            + Math.round(g.width) + "," + Math.round(g.height)];
        moveCall.call();
    }

    function moveFinished(w) {
        if (!w || root.movingWin !== w) return;
        moveTimer.stop();
        moveIdleTimer.stop();
        root.movingWin = null;
        root.moveGeo = null;
        root.lastJson = ""; // the last Move may differ from the final place (snapping, tiling)
        root.flush();       // one full snapshot: the receiver is exact again
    }

    // the receiver's reply: who it is, so its own overlay is left out of the list
    function onReply(returned) {
        root.linkAlive();
        try {
            root.applySelf(JSON.parse(returned[0]));
        } catch (e) {
            // an empty or foreign reply: keep what we know
        }
    }

    function applySelf(next) {
        if (!next || typeof next !== "object") return;
        const changed = next.selfPid !== root.cfg.selfPid || next.selfTitle !== root.cfg.selfTitle;
        root.cfg = next;
        if (next.zone !== undefined) root.zone = next.zone;
        // always written (once, and again if it changes): shows that this script is the one running and
        // that the receiver's environment (CAPRI_TRACE_KWIN, CAPRI_KWIN_NO_*, CAPRI_KWIN_TUNE_OFF) got here
        const flags = "trace=" + Boolean(next.trace) + " noGiveBack=" + Boolean(next.noGiveBack)
            + " noRaise=" + Boolean(next.noRaise) + " tuneOff=[" + (next.tuneOff || []).join(",") + "]";
        if (flags !== root.flagsKey) {
            root.flagsKey = flags;
            console.warn("capri-windows: script of patch 13, told: " + flags);
        }
        if (changed) {
            root.lastJson = ""; // send again, now without the overlay
            root.netKey = "";
            root.dirty = true;
        }
    }

    // the link supervisor (every call reports here, one place owns the timers)
    function linkAlive() {
        root.linkFails = 0;
        root.linkDown = false;
    }

    function linkLost() {
        root.lastJson = "";
        root.netKey = "";
        if (!root.linkDown) console.warn("capri-windows: no receiver on org.capri.WindowBridge");
        root.linkDown = true;
        // pollTimer fires even when the pointer is still and nothing else does, so a dead
        // receiver is noticed within interval linkFailLimit and the script unloads itself
        if (++root.linkFails >= root.linkFailLimit) root.shutdown();
    }

    function shutdown() {
        pollTimer.stop(); cursorTimer.stop(); netTimer.stop();
        flushTimer.stop(); moveTimer.stop(); moveIdleTimer.stop(); giveBackTimer.stop();
        nloadCall.arguments = ["capri-windows"];
        unloadCall.call();

    }

    DBusCall {
        id: bridge
        service: "org.capri.WindowBridge"
        path: "/org/capri/WindowBridge"
        dbusInterface: "org.capri.WindowBridge"
        method: "Update"
        onFinished: (returned) => root.onReply(returned)
        onFailed: root.linkLost()
    }

    DBusCall {
        id: cursorCall
        service: "org.capri.WindowBridge"
        path: "/org/capri/WindowBridge"
        dbusInterface: "org.capri.WindowBridge"
        method: "Cursor"
        onFinished: root.linkAlive()
        onFailed: root.linkLost()
    }

    DBusCall {
        id: commandCall
        service: "org.capri.WindowBridge"
        path: "/org/capri/WindowBridge"
        dbusInterface: "org.capri.WindowBridge"
        method: "Command"
        onFailed: root.onFailed()
    }

    DBusCall {
        id: pollCall
        service: "org.capri.WindowBridge"
        path: "/org/capri/WindowBridge"
        dbusInterface: "org.capri.WindowBridge"
        method: "Poll"
        onFinished: (returned) => root.runCommands(returned[0])
        onFailed: root.linkLost()
    }

    ShortcutHandler {
        name: "Capri: stow her or bring her back"
        text: "Capri: stow her or bring her back"
        sequence: "Ctrl+Alt+C"
        onActivated: root.command("toggle")
    }

    DBusCall {
        id: moveCall
        service: "org.capri.WindowBridge"
        path: "/org/capri/WindowBridge"
        dbusInterface: "org.capri.WindowBridge"
        method: "Move"
        onFinished: root.linkAlive()
        onFailed: root.linkLost()
    }

    DBusCall {
        id: unloadCall
        service: "org.kde.KWin"
        path: "/Scripting"
        dbusInterface: "org.kde.kwin.Scripting"
        method: "unloadScript"
    }

    // the trailing edge: what came in during the 8 ms is sent now
    Timer {
        id: moveTimer
        interval: 8
        repeat: false
        onTriggered: {
            if (root.moveGeo) {
                root.flushMove();
                moveTimer.start();
            }
        }
    }

    // if Finished never comes (the window vanished, KWin dropped the grab) the drag is over after 1 s
    Timer {
        id: moveIdleTimer
        interval: 1000
        repeat: false
        onTriggered: root.moveFinished(root.movingWin)
    }

    Timer {
        id: giveBackTimer
        interval: 250
        repeat: false
        onTriggered: root.giveBackIfStill()
    }

    Timer {
        id: flushTimer
        interval: 40
        repeat: false
        onTriggered: root.flush()
    }

    // The safety net for what has no signal (the workspace in view, the order of the stack,
    // outputs), and the way back after the receiver was away.
    Timer {
        id: netTimer
        interval: 500
        repeat: true
        running: true
        onTriggered: root.safetyNet()
    }

    // The receiver's commands (the keyboard for her chat, closing an app): often enough that typing
    // to her works as soon as the chat opens.
    // 150 ms while something is going on (the pointer moves, the keyboard is hers, a command waits);
    // the receiver slows it down when nothing is ("next" in its answer), and any pointer movement
    // brings the fast beat back at once (sendCursor).
    Timer {
        id: pollTimer
        interval: 150
        repeat: true
        running: true
        onTriggered: {
            pollCall.call();
            root.checkSelf();
        }
    }

    // 30 times a second at most while the pointer moves; every 100 ms once it has been still for a second
    Timer {
        id: cursorTimer
        interval: 33
        repeat: true
        running: true
        onTriggered: root.sendCursor()
    }

    Connections {
        target: Workspace

        function onWindowAdded(window) {
            root.watch(window);
            root.schedule();
        }

        function onWindowRemoved(window) {
            root.forget(window);
            root.schedule();
        }

        function onWindowActivated(window) {
            root.windowActivated(window);
        }

        function onScreensChanged() {
            root.schedule();
        }

        function onDesktopsChanged() {
            root.schedule();
        }

        function onCurrentActivityChanged(id) {
            root.schedule();
        }
    }

    Component.onDestruction: {
        for (let i = 0; i < root.hooked.length; i++) {
            try {
                root.hooked[i].s.disconnect(root.hooked[i].f);
            } catch (e) {
                // the window is gone, or the signal: nothing left to take back
            }
        }
        root.hooked = [];
    }

    Component.onCompleted: {
        console.warn("capri-windows: script loaded, build " + root.build);
        const order = Workspace.stackingOrder;
        for (let i = 0; i < order.length; i++) root.watch(order[i]);
        root.flush();
    }
}
