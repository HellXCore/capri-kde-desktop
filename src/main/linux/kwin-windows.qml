// Capri: window tracking for KDE Plasma 6 (Wayland), the KWin half.
//
// Runs inside KWin (a declarative KWin script), so it sees every window, XWayland and native
// Wayland. It collects, and pushes the result over D-Bus to the receiver in Electron (kwin-bridge.js),
// in the shapes x11.js already works with:
//
//   root   = what parseRoot() gives:   { active, stacking (front first), desktop }
//   infos  = what parseWindow() gives: id -> { types, state, desktop, frame, csd, pid }
//   rects  = what parseTree() gives:   id -> { x, y, w, h }   (KWin's frame, the title bar included)
//
// so x11.buildSnapshot() turns it into the snapshot windows.js expects. On top of that: `ai`, the
// AIs the window in front is (the title is matched here and never leaves KWin: only the keys do),
// `front` (what is in front, for a game heuristic) and `outputs` (scales, for the pixel units).
//
// Window ids are KWin-side counters, not X11 ids (the KWin scripting API has no X11 window id).
// Coordinates are KWin's global logical pixels.
//
// Loaded and unloaded by kwin-bridge.js through org.kde.KWin /Scripting; nothing to install.

import QtQuick
import org.kde.kwin

Item {
    id: root

    readonly property int maxWindows: 80
    // _NET_WM_DESKTOP of a window shown on every workspace (x11.js: ALL_DESKTOPS)
    readonly property var allDesktops: 4294967295

    // what the receiver tells us about itself, to leave its overlay out: { selfPid, selfTitle }
    property var cfg: ({ selfPid: 0, selfTitle: "" })
    property var ids: ({})      // window internalId -> number
    property var watched: ({})  // window internalId -> signals connected
    property int nextId: 1
    property string lastJson: ""
    property bool failing: false

    // ---------- what to send ----------

    function idOf(w) {
        const key = String(w.internalId);
        if (root.ids[key] === undefined) {
            root.ids[key] = root.nextId;
            root.nextId += 1;
        }
        return root.ids[key];
    }

    // the receiver's own overlay (and its other windows with the same title) is no seat
    function isSelf(w) {
        const c = root.cfg;
        return c.selfPid > 0 && w.pid === c.selfPid && (!c.selfTitle || w.captionNormal === c.selfTitle);
    }

    function onActivity(w) {
        const list = w.activities;
        if (!list || list.length === 0) return true;
        for (let i = 0; i < list.length; i++) {
            if (list[i] === Workspace.currentActivity) return true;
        }
        return false;
    }

    // EWMH type names, as x11.parseWindow() strips them ('NORMAL', 'DIALOG', 'DOCK'...).
    // x11.js lets only NORMAL and DIALOG be seats.
    function typesOf(w) {
        if (w.desktopWindow) return ["DESKTOP"];
        if (w.dock) return ["DOCK"];
        if (w.onScreenDisplay || w.notification || w.criticalNotification) return ["NOTIFICATION"];
        if (w.tooltip) return ["TOOLTIP"];
        if (w.dndIcon) return ["DND"];
        if (w.comboBox) return ["COMBO"];
        if (w.dropdownMenu) return ["DROPDOWN_MENU"];
        if (w.popupMenu || w.appletPopup || w.popupWindow) return ["POPUP_MENU"];
        if (w.menu) return ["MENU"];
        if (w.splash) return ["SPLASH"];
        if (w.toolbar) return ["TOOLBAR"];
        if (w.utility) return ["UTILITY"];
        if (w.dialog) return ["DIALOG"];
        if (w.normalWindow) return ["NORMAL"];
        return ["UTILITY"]; // unknown: not a seat
    }

    function deskIndex(d) {
        return d.x11DesktopNumber - 1; // _NET_CURRENT_DESKTOP counts from 0
    }

    // _NET_WM_DESKTOP, but "the workspace in view" is read per output (Plasma can keep one per
    // screen): a window on its own screen's current workspace reports the global current one,
    // so x11.isSeat() compares it right.
    function desktopOf(w, current) {
        if (w.onAllDesktops || !w.desktops || w.desktops.length === 0) return root.allDesktops;
        let shown = null;
        try {
            shown = Workspace.currentDesktopForScreen(w.output);
        } catch (e) {
            shown = null;
        }
        if (!shown) shown = Workspace.currentDesktop;
        for (let i = 0; i < w.desktops.length; i++) {
            if (shown && w.desktops[i].id === shown.id) return current;
        }
        return deskIndex(w.desktops[0]);
    }

    // _NET_WM_STATE names, without the prefix
    function stateOf(w) {
        const state = [];
        const mode = w.maximizeMode; // 0 restored, 1 vertical, 2 horizontal, 3 both
        if (w.minimized || w.hidden || !root.onActivity(w)) state.push("HIDDEN");
        if (w.skipTaskbar) state.push("SKIP_TASKBAR");
        if (w.fullScreen) state.push("FULLSCREEN");
        if (mode & 1) state.push("MAXIMIZED_VERT");
        if (mode & 2) state.push("MAXIMIZED_HORZ");
        if (w.onAllDesktops) state.push("STICKY");
        if (w.keepAbove) state.push("ABOVE");
        if (w.demandsAttention) state.push("DEMANDS_ATTENTION");
        return state;
    }

    function describe(w, current) {
        return {
            types: root.typesOf(w),
            state: root.stateOf(w),
            desktop: root.desktopOf(w, current),
            frame: null, // KWin's frameGeometry already is the outer rectangle, title bar included
            csd: null,   // and without the shadow a client-side-decorated window draws around itself
            pid: w.pid > 0 ? w.pid : null,
        };
    }

    function rectOf(w) {
        const g = w.frameGeometry;
        return { x: Math.round(g.x), y: Math.round(g.y), w: Math.round(g.width), h: Math.round(g.height) };
    }

    // The AIs the window in front is, by the keys bond.js knows (RIVALS). Only these leave KWin,
    // never the title. Keep it in step with the list in windows.ps1.
    function aiKeys(w) {
        if (!w) return [];
        const title = String(w.captionNormal || w.caption || "").toLowerCase();
        const table = [
            ["chatgpt", /chat\s?gpt/],
            ["claude", /\bclaude\b/],
            ["codex", /\bcodex\b/],
            ["gemini", /\bgemini\b/],
            ["copilot", /\bcopilot\b/],
            ["perplexity", /\bperplexity\b/],
            ["deepseek", /\bdeepseek\b/],
            ["grok", /\bgrok\b/],
            ["lechat", /\ble\s?chat\b|\blechat\b/],
            ["characterai", /character\.?\s?ai/],
            ["metaai", /\bmeta\s?ai\b/],
        ];
        const found = [];
        for (let i = 0; i < table.length; i++) {
            if (table[i][1].test(title)) found.push(table[i][0]);
        }
        return found;
    }

    function outputs() {
        const list = [];
        const screens = Workspace.screens;
        for (let i = 0; i < screens.length; i++) {
            const g = screens[i].geometry;
            list.push({
                x: Math.round(g.x), y: Math.round(g.y), w: Math.round(g.width), h: Math.round(g.height),
                s: screens[i].devicePixelRatio || 1,
            });
        }
        return list;
    }

    function collect() {
        const current = Workspace.currentDesktop ? root.deskIndex(Workspace.currentDesktop) : null;
        const order = Workspace.stackingOrder; // bottom to top; x11.js wants the front first
        const stacking = [];
        const infos = {};
        const rects = {};
        for (let i = order.length - 1; i >= 0 && stacking.length < root.maxWindows; i--) {
            const w = order[i];
            if (!w || w.deleted || w.outline || !w.managed || root.isSelf(w)) continue;
            const id = root.idOf(w);
            stacking.push(id);
            infos[id] = root.describe(w, current);
            rects[id] = root.rectOf(w);
        }

        // the window in front may be one outside the list (a panel): described anyway
        const active = Workspace.activeWindow;
        let activeId = null;
        let front = null;
        if (active && !active.deleted && !root.isSelf(active)) {
            activeId = root.idOf(active);
            if (!infos[activeId]) {
                infos[activeId] = root.describe(active, current);
                rects[activeId] = root.rectOf(active);
            }
            front = {
                cls: active.resourceClass || "",
                app: active.desktopFileName || "",
                fullScreen: Boolean(active.fullScreen),
                pid: active.pid > 0 ? active.pid : null,
            };
        }

        return {
            v: 1,
            root: { active: activeId, stacking: stacking, desktop: current },
            infos: infos,
            rects: rects,
            ai: root.aiKeys(active),
            front: front,
            outputs: root.outputs(),
        };
    }

    // ---------- when to send ----------

    function flush() {
        const json = JSON.stringify(root.collect());
        if (json === root.lastJson) return; // nothing changed: nothing sent
        root.lastJson = json;
        bridge.arguments = [json];
        bridge.call();
    }

    // coalesces the bursts (a window being dragged fires on every step) into one send per 40 ms
    function schedule() {
        if (!flushTimer.running) flushTimer.start();
    }

    function watch(w) {
        if (!w) return;
        const key = String(w.internalId);
        if (root.watched[key]) return;
        root.watched[key] = true;
        const signals = [
            "frameGeometryChanged", "minimizedChanged", "desktopsChanged", "activitiesChanged",
            "fullScreenChanged", "maximizedChanged", "captionChanged", "skipTaskbarChanged",
            "hiddenChanged", "stackingOrderChanged", "activeChanged", "outputChanged",
        ];
        for (let i = 0; i < signals.length; i++) {
            try {
                w[signals[i]].connect(root.schedule);
            } catch (e) {
                // this KWin has no such signal: the poll below still catches the change
            }
        }
    }

    function forget(w) {
        if (!w) return;
        const key = String(w.internalId);
        delete root.watched[key];
        delete root.ids[key];
    }

    // the receiver's reply: who it is, so its own overlay is left out of the list
    function onReply(returned) {
        root.failing = false;
        try {
            const next = JSON.parse(returned[0]);
            if (next && typeof next === "object") {
                const changed = next.selfPid !== root.cfg.selfPid || next.selfTitle !== root.cfg.selfTitle;
                root.cfg = next;
                if (changed) root.lastJson = ""; // send again, now without the overlay
            }
        } catch (e) {
            // an empty or foreign reply: keep what we know
        }
    }

    function onFailed() {
        // the receiver is gone (Capri closed): sent again when it is back
        root.lastJson = "";
        if (!root.failing) console.warn("capri-windows: no receiver on org.capri.WindowBridge");
        root.failing = true;
    }

    DBusCall {
        id: bridge
        service: "org.capri.WindowBridge"
        path: "/org/capri/WindowBridge"
        dbusInterface: "org.capri.WindowBridge"
        method: "Update"
        onFinished: (returned) => root.onReply(returned)
        onFailed: root.onFailed()
    }

    Timer {
        id: flushTimer
        interval: 40
        repeat: false
        onTriggered: root.flush()
    }

    // The safety net for what has no signal (the workspace in view, the order of the stack,
    // outputs), and the way back after the receiver was away.
    Timer {
        interval: 500
        repeat: true
        running: true
        onTriggered: root.flush()
    }

    Connections {
        target: Workspace

        function onWindowAdded(window) {
            root.watch(window);
            root.schedule();
        }

        function onWindowRemoved(window) {
            root.forget(window);
            root.schedule();
        }

        function onWindowActivated(window) {
            root.schedule();
        }

        function onScreensChanged() {
            root.schedule();
        }

        function onDesktopsChanged() {
            root.schedule();
        }

        function onCurrentActivityChanged(id) {
            root.schedule();
        }
    }

    Component.onCompleted: {
        const order = Workspace.stackingOrder;
        for (let i = 0; i < order.length; i++) root.watch(order[i]);
        root.flush();
    }
}
