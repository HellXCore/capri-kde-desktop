            if (root.cursorIdle === 30 && cursorTimer.interval !== 100) cursorTimer.interval = 100;
            return;
        }
        root.cursorKey = key;
        root.cursorIdle = 0;
        if (cursorTimer.interval !== 33) cursorTimer.interval = 33;
        if (pollTimer.interval !== 150) pollTimer.interval = 150; // she may be about to be used
