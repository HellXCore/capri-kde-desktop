{
  "name": "capri-desktop",
  "version": "0.3.0",
  "desktopName": "com.arasaka.capricorn",
  "description": "Capri, the Project Capricorn construct, living on your desktop and narrating what Claude Code is doing.",
  "author": "mochiiwuff",
  "repository": "github:HellXCore/capri-kde-desktop",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "demo": "node scripts/demo.js",
    "hooks:install": "node scripts/install-hooks.js",
    "hooks:uninstall": "node scripts/install-hooks.js --uninstall",
    "hooks:codex:install": "node scripts/install-codex-hooks.js",
    "hooks:codex:uninstall": "node scripts/install-codex-hooks.js --uninstall",
    "hooks:agy:install": "node scripts/install-hooks-agy.js",
    "hooks:agy:uninstall": "node scripts/install-hooks-agy.js --uninstall",
    "check:llm": "node scripts/check-llm.js",
    "test": "node --test tests/*.test.js",
    "test:hooks": "node --test tests/hooks.test.js",
    "test:smoke": "node scripts/smoke-test.js",
    "updater:smoke": "node scripts/updater-smoke.js",
    "dist": "electron-builder --linux AppImage deb --x64 --publish never"
  },
  "keywords": [
    "claude-code",
    "desktop-pet",
    "electron",
    "cyberpunk",
    "edgerunners"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
  "form-data": "^4.0.6",
  "qs": "^6.16.0",
  "tar": "^7.5.11",
  "tough-cookie": "^4.1.3",
  "uuid": "^11.1.1",
  "xml2js": "^0.5.0"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "electron-updater": "^6.6.2",
    "koffi": "^3.3.5"
  },
  "resolutions": {
    "form-data": "^4.0.6",
    "qs": "^6.16.0",
    "tar": "^7.5.11",
    "tough-cookie": "^4.1.3",
    "uuid": "^11.1.1",
    "xml2js": "^0.5.0"
  },
  "build": {
    "appId": "com.arasaka.capricorn",
    "productName": "Capri",
    "files": [
      "src/**",
      "assets/**",
      "hooks/**",
      "scripts/**",
      "package.json",
      "LICENSE"
    ],
    "asarUnpack": [
      "hooks/**"
    ],
    "artifactName": "Capri-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "HellXCore",
        "repo": "capri-kde-desktop",
        "releaseType": "release"
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "icon": "assets/icons/capri.png",
      "maintainer": "HellXCore <github.com/HellXCore>",
      "desktop": {
        "entry": {
          "StartupWMClass": "capri-desktop"
        }
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "x11-utils"
      ]
    }
  },
  "allowScripts": {
    "ejs@2.7.4": true,
    "koffi": true
  }
}
